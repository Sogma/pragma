{
  "name": "pragma",
  "version": "0.6.0",
  "private": true,
  "description": "A protocol and local editor for AI-native workflows over a markdown/html/fountain space.",
  "author": "SGM DevNet LLC",
  "repository": "github:sogma/pragma",
  "homepage": "https://github.com/sogma/pragma#readme",
  "bugs": {
    "url": "https://github.com/sogma/pragma/issues"
  },
  "type": "module",
  "main": "electron/main.ts",
  "bin": {
    "pragma": "./bin/pragma.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pragma": "node ./bin/pragma.ts",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit && tsc -p test --noEmit",
    "build": "vite build web --outDir ../dist/web --emptyOutDir",
    "prepare": "npm run build",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/electron/preload.js",
    "electron": "npm run build && npm run build:preload && electron .",
    "package": "npm run build && npm run build:preload && electron-builder --publish never",
    "release": "npm run build && npm run build:preload && electron-builder --publish always",
    "pack:npm": "node scripts/pack-npm.mjs",
    "preversion": "npm run typecheck",
    "postversion": "git push --follow-tags",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check . --max-diagnostics=none",
    "check:docs": "node scripts/check-docs.mjs",
    "format": "biome check --write ."
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/google": "^4.0.117",
    "@ai-sdk/mcp": "^2.0.96",
    "@ai-sdk/openai": "^4.0.114",
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@hono/node-server": "^2.1.6",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.169",
    "commander": "^15.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "hono": "^4.13.17",
    "jose": "^6.2.17",
    "node-html-parser": "^9.0.7",
    "simple-git": "^4.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
    "@mathjax/mathjax-tex-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@observablehq/plot": "^0.6.19",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@xyflow/system": "^0.0.84",
    "codemirror": "^6.0.2",
    "d3-force-3d": "^3.0.6",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "lightningcss": "^1.33.0",
    "pdfjs-dist": "^6.5.438",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "electron-winstaller": false,
    "esbuild": false
  }
}
