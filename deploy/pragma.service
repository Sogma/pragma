[Unit]
Description=Pragma editor (remote access)
After=network.target

[Service]
Type=simple
# Replace all four: the account pragma runs as, node's and pragma's full
# paths for that account (`which node`, `which pragma`: systemd doesn't use a
# login shell's PATH, and pragma alone looks for node on it), and the https://
# address your proxy serves. See docs/deployment.md.
User=pragma
ExecStart=/usr/bin/node /usr/local/bin/pragma start --external-url https://<machine>.<tailnet>.ts.net --port 14319
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
